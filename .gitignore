# Local settings and credentials
config.local.do
**/config.local.do
.env
.env.*
!.env.example
*.pem
*.key

# Generated datasets and reports: retain folders via .gitkeep only.
/data/**
!/data/**/
!/data/**/.gitkeep
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
!/outputs/README.md
# The regression receipt is generated, but it is published deliberately: it is
# how a reader checks what was estimated without running Stata. It carries a
# run timestamp, so it is excluded from SHA256SUMS.txt (see scripts/).
!/outputs/audit/REGRESSIONS.txt

# Historical working material stays local; publish its index only.
/archive/**
!/archive/README.md

# OS, Python, Stata and local packaging artifacts
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.dta
*.ster
*.gph
*.smcl
*.log
*.zip
/work/
